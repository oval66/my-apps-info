---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Sidebar from '../components/Sidebar.astro';
import { DEVELOPER_INFO } from '../data/apps';

interface Props {
  title?: string;
  description?: string;
  activeNav?: 'home' | 'apps' | 'support' | 'privacy' | 'terms' | 'legal';
  currentAppSlug?: string;
}

const {
  title = 'Apps — Junichi MIZUKAMI',
  description = 'Elevate your daily iOS workflow with our minimalist native apps, support resources, and legal documentation.',
  activeNav = 'apps',
  currentAppSlug,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#FAFAFA] text-[#111215] flex flex-col">
    <TopBar />

    <div class="flex-1 flex flex-col lg:flex-row w-full">
      <Sidebar activeNav={activeNav} currentAppSlug={currentAppSlug} />

      <main class="flex-1 max-w-5xl w-full px-6 md:px-8 py-8 md:py-10">
        <slot />

        <footer class="mt-16 pt-6 border-t border-gray-200/80 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-[#6B7280]">
          <p>
            © 2026 {DEVELOPER_INFO.studioName}. All rights reserved.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a href="/" class="underline decoration-gray-400 underline-offset-2 hover:text-black">
              Apps Directory
            </a>
            <a href="/support" class="underline decoration-gray-400 underline-offset-2 hover:text-black">
              Support Center
            </a>
            <a href="/legal#privacy" class="underline decoration-gray-400 underline-offset-2 hover:text-black">
              Privacy Policy
            </a>
            <a href="/legal#terms" class="underline decoration-gray-400 underline-offset-2 hover:text-black">
              Terms of Use
            </a>
          </div>
        </footer>
      </main>
    </div>
  </body>
</html>

