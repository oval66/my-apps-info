---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { APPS, DEVELOPER_INFO } from '../data/apps';
---

<DashboardLayout
  title="Support Center — ChordTrainer & SketchChord"
  description="Customer support directory, troubleshooting guides, and contact emails for ChordTrainer and SketchChord."
  activeNav="support"
>
  <div class="mb-5">
    <h1 class="text-2xl md:text-3xl font-semibold tracking-tight text-[#111215]">
      Support
    </h1>
    <p class="text-sm font-normal text-[#6B7280] mt-1">
      Select an application below to view its dedicated FAQ, MIDI/Audio troubleshooting guides, or contact our support desk.
    </p>
  </div>

  <!-- 1px Shared-Border App Support Directory Grid -->
  <section
    aria-label="App Support Directory"
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border-l border-gray-200 mb-10"
  >
    {
      APPS.map((app, index) => (
        <article
          class:list={[
            'bg-white border-r border-b border-gray-200 p-8 flex flex-col items-center text-center justify-start hover:bg-gray-50/50 transition-colors',
            index === 0 && 'border-t',
            index === 1 && 'md:border-t',
            index === 2 && 'lg:border-t',
          ]}
        >
          <a
            href={`/apps/${app.slug}/support`}
            class="w-14 h-14 rounded-2xl shadow-sm mb-4 flex items-center justify-center shrink-0 overflow-hidden border border-gray-200/60"
            style={`background-color: ${app.iconBg}; color: ${app.iconFg ?? '#FFFFFF'};`}
          >
            {app.iconUrl ? (
              <img
                src={app.iconUrl}
                alt={`${app.name} App Icon`}
                class="w-full h-full object-cover"
              />
            ) : (
              <svg class="w-7 h-7" viewBox="0 0 24 24" set:html={app.iconSvg} />
            )}
          </a>

          <h2 class="text-base font-semibold text-[#111215] text-center mb-1">
            <a href={`/apps/${app.slug}/support`} class="hover:underline underline-offset-4 decoration-gray-400">
              {app.name}
            </a>
          </h2>

          <p class="text-xs text-[#6B7280] mb-3">
            v{app.version} · {app.iosRequirement}
          </p>

          <p class="text-xs leading-relaxed text-[#6B7280] text-center max-w-[260px] mb-4">
            {app.faqs.length}件の公式FAQ（MIDI認識・発音・保存設定等）とトラブルシューティングを掲載。{' '}
            <a
              href={`/apps/${app.slug}/support`}
              class="underline decoration-gray-400 underline-offset-2 hover:text-black"
            >
              Open Support
            </a>
          </p>

          <a
            href={`mailto:${app.supportEmail}`}
            class="text-xs text-[#6B7280] underline decoration-gray-400 underline-offset-2 hover:text-black mt-auto"
          >
            {app.supportEmail}
          </a>
        </article>
      ))
    }
  </section>

  <!-- General Studio Support Box -->
  <div class="bg-white border border-gray-200 p-8 md:p-12">
    <div class="prose prose-gray max-w-none prose-headings:text-[#111215] prose-p:text-[#6B7280] prose-li:text-[#6B7280] prose-a:text-[#111215]">
      <h2 class="mt-0">General Inquiries & App Store Support (総合お問い合わせ窓口)</h2>
      <p>
        <strong>ChordTrainer</strong> および <strong>SketchChord</strong> に関するご意見・不具合報告・機能リクエストは、下記の専用お問い合わせフォームより直接お送りいただけます。
      </p>
      <ul>
        <li>
          <strong>運営・開発者 (Developer):</strong> {DEVELOPER_INFO.studioName}
        </li>
        <li>
          <strong>連絡先メールアドレス (Contact Email):</strong>{' '}
          <a href={`mailto:${DEVELOPER_INFO.contactEmail}`}>{DEVELOPER_INFO.contactEmail}</a>
        </li>
        <li>
          <strong>受付・回答目安:</strong> 通常 24〜48 営業時間以内（土日祝を除く）に順次ご返信いたします。お問い合わせの際はご利用端末（iPhone / iPad）および OS バージョンをご記載いただくとスムーズです。
        </li>
        <li>
          <strong>App内課金・チップの復元と返金について:</strong> Apple StoreKit 2 による決済および返金処理はすべて Apple 側で管理されています。返金リクエスト等については{' '}
          <a href="https://reportaproblem.apple.com" target="_blank" rel="noopener noreferrer">
            reportaproblem.apple.com
          </a>{' '}
          をご利用ください。
        </li>
      </ul>
    </div>

    <!-- Embedded Tally Support Form -->
    <div class="mt-8 pt-8 border-t border-gray-200">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <div>
          <h3 class="text-base font-semibold text-[#111215]">
            お問い合わせフォーム (Contact Form)
          </h3>
          <p class="text-xs text-[#6B7280] mt-0.5">
            ご質問・不具合報告・ご要望をこちらのフォームから直接送信できます。
          </p>
        </div>
        <a
          href="https://tally.so/r/o99Ykb"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium text-[#111215] bg-gray-100 hover:bg-gray-200/80 border border-gray-200 rounded-lg transition-colors self-start sm:self-auto shrink-0"
        >
          <span>別タブでフォームを開く</span>
          <svg class="w-3.5 h-3.5 text-[#6B7280]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 17L17 7M17 7H8M17 7V16" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <div class="bg-white border border-gray-200 p-6 md:p-8">
        <iframe
          data-tally-src="https://tally.so/embed/o99Ykb?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
          loading="lazy"
          width="100%"
          height="284"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          title="お問い合わせフォーム (Contact Support)"
        ></iframe>
      </div>

      <p class="text-xs text-[#6B7280] mt-3">
        ※フォームが表示されない場合は{' '}
        <a
          href={`mailto:${DEVELOPER_INFO.contactEmail}`}
          class="underline decoration-gray-400 underline-offset-2 hover:text-black"
        >
          {DEVELOPER_INFO.contactEmail}
        </a>{' '}
        まで直接メールでお送りください
      </p>
    </div>
  </div>

  <script is:inline>
    var d = document,
      w = "https://tally.so/widgets/embed.js",
      v = function () {
        if (typeof Tally !== "undefined") {
          Tally.loadEmbeds();
        } else {
          d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach(function (e) {
            e.src = e.dataset.tallySrc;
          });
        }
      };
    if (typeof Tally !== "undefined") {
      v();
    } else if (d.querySelector('script[src="' + w + '"]') == null) {
      var s = d.createElement("script");
      s.src = w;
      s.onload = v;
      s.onerror = v;
      d.body.appendChild(s);
    }
  </script>
</DashboardLayout>
