---
import { DEVELOPER_INFO } from '../data/apps';
---

<header class="w-full bg-[#FAFAFA] px-4 md:px-6 pt-3 pb-2 flex items-center justify-between select-none">
  <div class="flex items-center gap-2.5">
    <a href="/" class="flex items-center gap-2 group focus:outline-none">
      <span class="font-heading font-bold text-sm tracking-tight text-[#111215] group-hover:underline underline-offset-4 decoration-gray-400">
        {DEVELOPER_INFO.studioName}
      </span>
    </a>
    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200/80">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      {DEVELOPER_INFO.status}
      <svg class="w-3 h-3 text-emerald-600/80" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
      </svg>
    </span>
  </div>

  <div class="flex items-center gap-3">
    <a
      href="/support"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-[#111215] bg-gray-200/70 hover:bg-gray-200 transition-colors"
    >
      <svg class="w-3.5 h-3.5 text-[#111215]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 8v8M8 12h8" stroke-linecap="round" />
      </svg>
      <span>Contact Support</span>
    </a>
    <a
      href="/legal"
      title="Legal Portal & Policies"
      class="p-1.5 text-gray-500 hover:text-[#111215] transition-colors rounded-md"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
        <path d="M4 5a2 2 0 012-2h12a2 2 0 012 2v10a2 2 0 01-2 2H8l-4 4V5z" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
    <a
      href="/"
      title={DEVELOPER_INFO.studioName}
      class="w-7 h-7 rounded-full bg-[#9D2B4B] text-white text-xs font-semibold flex items-center justify-center"
    >
      {DEVELOPER_INFO.handle.charAt(0)}
    </a>
  </div>
</header>

